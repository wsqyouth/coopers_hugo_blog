{{- /* 全文 RSS：Hugo 内置模板只输出 description（一句话），
       用阅读器的读者必须点进站才能看到内容。这里改成输出全文。 */ -}}
{{- $pctx := . -}}
{{- if .IsHome -}}{{ $pctx = .Site }}{{- end -}}
{{- $pages := slice -}}
{{- if or $.IsHome $.IsSection -}}
{{- $pages = $pctx.RegularPages -}}
{{- else -}}
{{- $pages = $pctx.Pages -}}
{{- end -}}
{{- /* 主订阅只送达文章；短笔记由 /notes/index.xml 独立订阅。 */ -}}
{{- if .IsHome -}}
{{- $pages = where $pages "Section" "in" site.Params.mainSections -}}
{{- end -}}
{{- $pages = $pages.ByDate.Reverse -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
{{- $pages = $pages | first $limit -}}
{{- end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ if eq .Title .Site.Title }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{.}} on {{ end }}{{ .Site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>Recent content {{ if ne .Title .Site.Title }}{{ with .Title }}in {{.}} {{ end }}{{ end }}on {{ .Site.Title }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.LanguageCode }}</language>
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $pages }}
    {{- /* 阅读器没有文章页的基址：补全正文中的相对图片与链接。 */ -}}
    {{- $content := .Content -}}
    {{- $permalink := .Permalink -}}
    {{- range findRE `(href|src)="[^"]+"` $content -}}
      {{- $attribute := . -}}
      {{- $url := replaceRE `^(href|src)="([^"]+)"$` "$2" . -}}
      {{- if not (findRE `^([a-zA-Z][a-zA-Z0-9+.-]*:|//)` $url) -}}
        {{- $absolute := printf "%s%s" $permalink $url -}}
        {{- if strings.HasPrefix $url "/" -}}{{- $absolute = $url | absURL -}}{{- end -}}
        {{- $content = replace $content $attribute (replace $attribute $url $absolute) -}}
      {{- end -}}
    {{- end -}}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ $content | html }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
